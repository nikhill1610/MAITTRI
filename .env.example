# ==============================================================================
# Maitri Smart Agriculture AI Platform - Root Environment Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env) and configure values.
# NEVER commit real credentials, production secret keys, or private tokens to Git!

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Secret key used for JWT token encoding/decoding. Change to a secure random string in production.
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Database connection URL (defaults to SQLite if not specified)
DATABASE_URL=sqlite:///./agri.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/maitri_agri

# Allowed CORS Origins (comma-separated list of frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Backend server host & port (default: 0.0.0.0 for LAN access by IoT devices)
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# API URL endpoint used by the frontend to reach the FastAPI backend
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: Google Maps JavaScript API Key
# If omitted or left blank, the application automatically uses OpenStreetMap / Leaflet (no key required)
VITE_GOOGLE_MAPS_API_KEY=
