# ==============================================================================
# MAITRI Smart Agriculture AI Platform — Root Environment Template
# ==============================================================================
# Copy this file to .env (or configure backend/.env and frontend/.env separately).
# NEVER commit real credentials, production secret keys, or private tokens to Git!

# ------------------------------------------------------------------------------
# 1. Backend Runtime & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production

# Supabase PostgreSQL connection pooler URI
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# Allowed CORS Origins (comma-separated list of frontend URLs)
CORS_ORIGINS=https://your-frontend-domain.onrender.com,https://your-app.vercel.app,http://localhost:5173

HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Services
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-frontend

# ------------------------------------------------------------------------------
# 3. OpenRouter AI Assistant
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# 4. IoT & Hardware Gateway
# ------------------------------------------------------------------------------
IOT_SERVER_URL=https://your-backend-domain.onrender.com
PUBLIC_API_URL=https://your-backend-domain.onrender.com

# ------------------------------------------------------------------------------
# 5. Communications (SMS & IVR Gateways)
# ------------------------------------------------------------------------------
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=MAITRI
SMS_TEMPLATE_ID=

IVR_PROVIDER=demo
IVR_API_KEY=
IVR_API_SECRET=
IVR_ACCOUNT_SID=
IVR_NUMBER=+91XXXXXXXXXX
IVR_WEBHOOK_BASE_URL=https://your-backend-domain.onrender.com/api/communications/ivr

# ------------------------------------------------------------------------------
# 6. Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000/api
VITE_GOOGLE_MAPS_API_KEY=
