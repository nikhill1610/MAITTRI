# =============================================================================
# MAITRI — Production & Development Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit the real .env file with actual credentials into git.

# Runtime Environment (production | development | test)
ENVIRONMENT=production

# Application Core Security
# In production, SECRET_KEY must be a cryptographically secure string of at least 32 characters.
SECRET_KEY=change-this-to-a-secure-random-32-character-secret-in-production

# Database Configuration
# Production requires Supabase PostgreSQL (or standard PostgreSQL) connection pooler URI.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://your-frontend-domain.onrender.com,https://your-app.vercel.app,http://localhost:5173

# Server Binding
HOST=0.0.0.0
PORT=8000

# Supabase Platform Credentials
# Server-side administration and private storage vault ('farmer-vault') integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-frontend

# OpenRouter AI Chatbot Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# IoT / ESP32 Hardware Server URL (Public endpoint advertised to microcontroller devices)
IOT_SERVER_URL=https://your-backend-domain.onrender.com
PUBLIC_API_URL=https://your-backend-domain.onrender.com

# SMS Gateway Configuration (Provider-Agnostic)
# Supported providers: demo, twilio, fast2sms, gupshup
SMS_PROVIDER=demo
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=MAITRI
SMS_TEMPLATE_ID=

# IVR Telephony Gateway Configuration (Provider-Agnostic)
# Supported providers: demo, twilio, exotel
IVR_PROVIDER=demo
IVR_API_KEY=
IVR_API_SECRET=
IVR_ACCOUNT_SID=
IVR_NUMBER=+91XXXXXXXXXX
IVR_WEBHOOK_BASE_URL=https://your-backend-domain.onrender.com/api/communications/ivr

# External Agriculture & Weather APIs (Optional)
WEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
