# Backend API Base URL
# - Local Development:  http://127.0.0.1:8000/api
# - Production (Vercel): https://<your-backend-service>.onrender.com/api
# - Reverse Proxy / CDN: /api
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: Google Maps JavaScript API Key (defaults to Leaflet/OpenStreetMap if unset)
VITE_GOOGLE_MAPS_API_KEY=
